{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "humphreys-transit-planner",
  "compatibility_date": "2026-06-19",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  // PUBLIC_ORIGIN: sent as Referer on outbound Mapbox calls so a URL-restricted
  // public token accepts them. Not a secret; committed here.
  "vars": {
    "PUBLIC_ORIGIN": "https://humphreysbus.app"
  },
  // Per-client-IP cap on billed Mapbox calls (edge-cache misses only; see
  // worker/index.js cost guards). A plan from a new spot costs ~5-12 misses
  // and a place search a few more, so 40/min leaves headroom for shared
  // barracks / carrier NAT while stopping a script. namespace_id is an
  // arbitrary account-unique integer.
  // Anonymous usage events + Mapbox call outcomes (worker/index.js
  // recordEvent). Free plan: 100k data points/day.
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "htp_events" }
  ],
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }
  ]
  // Secret: MAPBOX_TOKEN (Mapbox Directions API, walk-leg proxy).
  //   set via: wrangler secret put MAPBOX_TOKEN
  // See worker/index.js and Roadmap.md → Phase 3.
}
